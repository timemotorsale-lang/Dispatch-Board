}

model VehicleOperationsRolloutEvent {
  id             String       @id @default(cuid())
  organizationId String
  actorUserId    String
  action         String
  reason         String
  priorState     Json
  nextState      Json
  correlationId  String
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actorUser      User         @relation("VehicleOperationsRolloutActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([organizationId, createdAt])
  @@index([correlationId])
}

model EnterpriseProjectionCheckpoint {
  id                 String       @id @default(cuid())
  organizationId     String
  locationId         String?
  projectionCode     String
  lastEventOccurredAt DateTime?
  lastSuccessAt      DateTime?
  lastFailureAt      DateTime?
  lastError          String?
  lagSeconds         Int          @default(0)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  location           Location?    @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, locationId, projectionCode])
  @@index([organizationId, lastFailureAt])
}

model GenerationRun {
  id                String                @id @default(cuid())
  boardDate         DateTime              @db.Date
  startedAt         DateTime              @default(now())
  finishedAt        DateTime?
  status            GenerationRunStatus   @default(RUNNING)
  triggeredBy       GenerationTriggerType
  triggeredByUserId String?
  summary           Json
  errorMessage      String?
  triggeredByUser   User?                 @relation("GenerationRunTriggeredByUser", fields: [triggeredByUserId], references: [id], onDelete: SetNull)

  @@index([boardDate, startedAt])
}

model SchedulerAttempt {
  id                     String                        @id @default(cuid())
  boardDate              DateTime                      @db.Date
  triggerType            GenerationTriggerType         @default(SCHEDULED)
  triggerSource          SchedulerTriggerSource        @default(UNKNOWN)
  routePath              String
  requestMethod          String
  receivedAt             DateTime                      @default(now())
  startedAt              DateTime?
  completedAt            DateTime?
  attemptState           SchedulerAttemptState         @default(RECEIVED)
  authorizationOutcome   SchedulerAuthorizationOutcome @default(PENDING)
  generationRunId        String?
  managerMessage         String
  skipReasonCode         SchedulerSkipReasonCode?
  unauthorizedReasonCode String?
  failureStage           SchedulerFailureStage?
  failureCode            String?
  failureDiagnostic      Json?
  safeErrorMessage       String?
  createdAt              DateTime                      @default(now())
  updatedAt              DateTime                      @updatedAt

  @@index([boardDate, receivedAt])
  @@index([attemptState, receivedAt])
  @@index([authorizationOutcome, receivedAt])
  @@index([generationRunId])
}
