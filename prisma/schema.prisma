// Placeholder model for the v0.1.0 foundation migration.
// Domain models are intentionally deferred to later milestones.
model BootstrapMarker {
  id        String   @id @default(cuid())
  label     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id                                    String                                 @id @default(cuid())
  name                                  String
  email                                 String                                 @unique
  passwordHash                          String
  isActive                              Boolean                                @default(true)
  createdAt                             DateTime                               @default(now())
  updatedAt                             DateTime                               @updatedAt
  sessions                              Session[]
  userRoles                             UserRole[]
  userDuties                            UserDuty[]
  generatedBoardDays                    BoardDay[]                             @relation("BoardDayGeneratedByUser")
  assignedTasks                         Task[]                                 @relation("TaskAssignedUser")
  recommendedTasks                      Task[]                                 @relation("TaskRecommendedUser")
  createdTasks                          Task[]                                 @relation("TaskCreatedByUser")
  reviewedTasks                         Task[]                                 @relation("TaskReviewedByUser")
  acceptedTasks                         Task[]                                 @relation("TaskAcceptedByUser")
  completionOverriddenTasks             Task[]                                 @relation("TaskCompletionOverrideByUser")
  authoredTaskComments                  TaskComment[]                          @relation("TaskCommentAuthorUser")
  activityEvents                        ActivityEvent[]
  triggeredGenerationRuns               GenerationRun[]                        @relation("GenerationRunTriggeredByUser")
  createdLocationClosures               LocationClosure[]                      @relation("LocationClosureCreatedByUser")
  ownedAppointments                     Appointment[]                          @relation("AppointmentOwnerUser")
  createdAppointments                   Appointment[]                          @relation("AppointmentCreatedByUser")
  appointmentParticipants               AppointmentParticipant[]
  appointmentLocationAccess             UserLocationAccess[]
  createdAppointmentTaskLinks           AppointmentTaskLink[]                  @relation("AppointmentTaskLinkCreatedByUser")
  appointmentHistoryEvents              AppointmentHistoryEvent[]              @relation("AppointmentHistoryEventActorUser")
  appointmentCommandLedgerEntries       AppointmentCommandLedger[]             @relation("AppointmentCommandLedgerActorUser")
  schedulableResources                  SchedulableResource[]                  @relation("SchedulableResourceUser")
  createdResourceUnavailability         ResourceUnavailability[]               @relation("ResourceUnavailabilityCreatedByUser")
  createdAppointmentCatalogVersions     AppointmentCatalogVersion[]            @relation("AppointmentCatalogVersionCreatedByUser")
  activatedAppointmentCatalogVersions   AppointmentCatalogVersion[]            @relation("AppointmentCatalogVersionActivatedByUser")
  appointmentCatalogChangeEvents        AppointmentCatalogChangeEvent[]        @relation("AppointmentCatalogChangeEventActorUser")
  createdAppointmentAutomationRules     AppointmentAutomationRule[]            @relation("AppointmentAutomationRuleCreatedByUser")
  activatedAppointmentAutomationRules   AppointmentAutomationRule[]            @relation("AppointmentAutomationRuleActivatedByUser")
  appointmentAutomationRuleChangeEvents AppointmentAutomationRuleChangeEvent[] @relation("AppointmentAutomationRuleChangeEventActorUser")
  appointmentAutomationExecutionEvents  AppointmentAutomationExecutionEvent[]  @relation("AppointmentAutomationExecutionEventActorUser")
  createdTaskSavedViews                 TaskSavedView[]                        @relation("TaskSavedViewCreatedByUser")
  reportedConcerns                      ConcernCase[]                          @relation("ConcernReportedByUser")
  ownedConcerns                         ConcernCase[]                          @relation("ConcernAssignedOwner")
  closedConcerns                        ConcernCase[]                          @relation("ConcernClosedByUser")
  ownedCustomerPromises                 CustomerPromise[]                     @relation("CustomerPromiseOwner")
  fulfilledCustomerPromises             CustomerPromise[]                     @relation("CustomerPromiseFulfilledBy")
  ownedCustomers                        Customer[]                            @relation("CustomerOwner")
  authoredCustomerInteractions          CustomerInteraction[]                 @relation("CustomerInteractionActor")
  authoredCustomerNotes                 CustomerNote[]                        @relation("CustomerNoteAuthor")
  completedChecklistItems               TaskChecklistItem[]                    @relation("TaskChecklistCompletedByUser")
  staffDays                             StaffDay[]
  completedStaffDayDutyItems            StaffDayDutyItem[]                     @relation("StaffDayDutyCompletedByUser")
  claimedWorkRecommendations            WorkRecommendation[]                   @relation("WorkRecommendationClaimedByUser")
  requestedTaskAssignments              TaskAssignmentRequest[]                @relation("TaskAssignmentRequestRequester")
  decidedTaskAssignmentRequests         TaskAssignmentRequest[]                @relation("TaskAssignmentRequestDecisionMaker")
  submittedStaffDailyReports             StaffDailyReport[]                     @relation("StaffDailyReportSubmittedByUser")
  taskCollaborations                     TaskCollaborator[]                     @relation("TaskCollaboratorUser")
  addedTaskCollaborators                 TaskCollaborator[]                     @relation("TaskCollaboratorAddedByUser")
  crmDecisionOverrides                   CrmDecisionRecord[]                    @relation("CrmDecisionOverrideUser")
  ownedCustomerLeads                     CustomerLead[]                         @relation("CustomerLeadOwner")
  createdCustomerLeads                   CustomerLead[]                         @relation("CustomerLeadCreatedBy")
  vehicleCapabilityGrants                VehicleCapabilityGrant[]
  enterpriseCommandLedgerEntries         EnterpriseCommandLedger[]             @relation("EnterpriseCommandActor")
  enterpriseAuditEvents                  EnterpriseAuditEvent[]                 @relation("EnterpriseAuditActor")
  updatedVehicleOperationsFeatureFlags   VehicleOperationsFeatureFlag[]         @relation("VehicleOperationsFeatureFlagUpdater")
  vehicleOperationsRolloutEvents         VehicleOperationsRolloutEvent[]        @relation("VehicleOperationsRolloutActor")
  recordedVehicleOdometerObservations    VehicleOdometerObservation[]           @relation("VehicleOdometerRecorder")
  recordedVehicleCustodyEvents           VehicleCustodyEvent[]                  @relation("VehicleCustodyRecorder")
  resolvedVehicleDuplicateCases          VehicleDuplicateCase[]                 @relation("VehicleDuplicateResolver")
  ownedInventoryUnits                    InventoryUnit[]                         @relation("InventoryUnitOwner")
  inventoryUnitStateEvents               InventoryUnitStateEvent[]               @relation("InventoryUnitStateActor")
  inventoryUnitStateOwnershipSnapshots   InventoryUnitStateEvent[]               @relation("InventoryUnitStateOwner")
  ownedRepairOrders                      RepairOrder[]                            @relation("RepairOrderOwner")
  createdServiceVisits                   ServiceVisit[]                           @relation("ServiceVisitCreatedBy")
  repairOrderStateEvents                 RepairOrderStateEvent[]                  @relation("RepairOrderStateActor")
  repairOrderStateOwnershipSnapshots     RepairOrderStateEvent[]                  @relation("RepairOrderStateOwner")

  @@index([isActive])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Role {
  id          String         @id @default(cuid())
  name        String         @unique
  description String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  userRoles   UserRole[]
  roleDuties  RoleDuty[]
  templates   TaskTemplate[]
  staffDayDutyItems StaffDayDutyItem[]
}

model Duty {
  id           String         @id @default(cuid())
  name         String         @unique
  workflowArea String
  description  String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  userDuties   UserDuty[]
  roleDuties   RoleDuty[]
  templates    TaskTemplate[]
  sourceTasks  Task[]         @relation("TaskSourceDuty")
  staffDayDutyItems StaffDayDutyItem[]
}

model UserRole {
  userId     String
  roleId     String
  assignedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

model UserDuty {
  userId     String
  dutyId     String
  assignedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  duty       Duty     @relation(fields: [dutyId], references: [id], onDelete: Cascade)

  @@id([userId, dutyId])
  @@index([dutyId])
}

model RoleDuty {
  roleId     String
  dutyId     String
  assignedAt DateTime @default(now())
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  duty       Duty     @relation(fields: [dutyId], references: [id], onDelete: Cascade)

  @@id([roleId, dutyId])
  @@index([dutyId])
}

model AppSetting {
  id                  String        @id
  dailyGenerationTime String
  timezone            String
  businessDays        BusinessDay[]
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
}

model Organization {
  id                                    String                                 @id @default(cuid())
  code                                  String                                 @unique
  name                                  String
  createdAt                             DateTime                               @default(now())
  updatedAt                             DateTime                               @updatedAt
  locations                             Location[]
  appointments                          Appointment[]
  appointmentCommandLedgerEntries       AppointmentCommandLedger[]
  customers                             Customer[]
  vehicles                              Vehicle[]
  vehicleRelationships                  VehicleRelationship[]
  vehicleExternalIdentities             VehicleExternalIdentity[]
  vehicleOdometerObservations           VehicleOdometerObservation[]
  vehicleCustodyEvents                  VehicleCustodyEvent[]
  vehicleDuplicateCases                 VehicleDuplicateCase[]
  inventoryUnits                        InventoryUnit[]
  inventoryUnitStateEvents              InventoryUnitStateEvent[]
  serviceVisits                         ServiceVisit[]
  repairOrders                          RepairOrder[]
  repairOrderStateEvents                RepairOrderStateEvent[]
  resourceTypes                         SchedulableResourceType[]
  resources                             SchedulableResource[]
  appointmentCatalogVersions            AppointmentCatalogVersion[]
  appointmentCatalogChangeEvents        AppointmentCatalogChangeEvent[]
  appointmentAutomationRules            AppointmentAutomationRule[]
  appointmentAutomationExecutions       AppointmentAutomationExecution[]
  appointmentAutomationRuleChangeEvents AppointmentAutomationRuleChangeEvent[]
  appointmentAutomationExecutionEvents  AppointmentAutomationExecutionEvent[]
  crmDecisionRecords                     CrmDecisionRecord[]
  customerLeads                          CustomerLead[]
  concernCases                           ConcernCase[]
  customerSlaPolicies                    CustomerSlaPolicy[]
  crmFeatureFlags                        CustomerCrmFeatureFlag[]
  crmRolloutEvents                       CustomerCrmRolloutEvent[]
  crmCalibrationSnapshots                CustomerCrmCalibrationSnapshot[]
  enterpriseAggregateVersions            EnterpriseAggregateVersion[]
  enterpriseCommandLedgerEntries         EnterpriseCommandLedger[]
  enterpriseDomainEvents                 EnterpriseDomainEvent[]
  enterpriseAuditEvents                  EnterpriseAuditEvent[]
  enterpriseOutboxMessages               EnterpriseOutboxMessage[]
  vehicleCapabilityGrants                VehicleCapabilityGrant[]
  vehicleOperationsFeatureFlags          VehicleOperationsFeatureFlag[]
  vehicleOperationsRolloutEvents         VehicleOperationsRolloutEvent[]
  enterpriseProjectionCheckpoints        EnterpriseProjectionCheckpoint[]
}

model Location {
  id                              String                     @id @default(cuid())
  organizationId                  String
  code                            String
  name                            String
  timezone                        String
  addressLine1                    String?
  addressLine2                    String?
  city                            String
  region                          String
  postalCode                      String?
  phoneNumber                     String?
  countryCode                     String                     @default("US")
  schedulingStatus                LocationSchedulingStatus   @default(DRAFT)
  createdAt                       DateTime                   @default(now())
  updatedAt                       DateTime                   @updatedAt
  organization                    Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  operatingWindows                LocationOperatingWindow[]
  closures                        LocationClosure[]
  appointments                    Appointment[]
  appointmentCommandLedgerEntries AppointmentCommandLedger[]
  userAccess                      UserLocationAccess[]
  resources                       SchedulableResource[]
  enterpriseAggregateVersions     EnterpriseAggregateVersion[]
  enterpriseCommandLedgerEntries  EnterpriseCommandLedger[]
  enterpriseDomainEvents          EnterpriseDomainEvent[]
  enterpriseAuditEvents           EnterpriseAuditEvent[]
  enterpriseOutboxMessages        EnterpriseOutboxMessage[]
  vehicleCapabilityGrants         VehicleCapabilityGrant[]
  vehicleOperationsFeatureFlags   VehicleOperationsFeatureFlag[]
  enterpriseProjectionCheckpoints EnterpriseProjectionCheckpoint[]
  vehicleCustodyEvents             VehicleCustodyEvent[]
  inventoryUnits                   InventoryUnit[]
  inventoryUnitStateEvents         InventoryUnitStateEvent[]
  serviceVisits                   ServiceVisit[]
  repairOrders                    RepairOrder[]
  repairOrderStateEvents          RepairOrderStateEvent[]

  @@unique([organizationId, code])
  @@unique([id, organizationId])
  @@index([organizationId, schedulingStatus])
  @@index([city, region])
}

model LocationOperatingWindow {
  id             String      @id @default(cuid())
  locationId     String
  businessDay    BusinessDay
  opensAtMinute  Int
  closesAtMinute Int
  validFrom      DateTime    @db.Date
  validTo        DateTime?   @db.Date
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  location       Location    @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([locationId, businessDay, opensAtMinute, validFrom])
  @@index([locationId, businessDay, validFrom, validTo])
}

model LocationClosure {
  id              String              @id @default(cuid())
  locationId      String
  type            LocationClosureType
  name            String
  startsAt        DateTime
  endsAt          DateTime
  reason          String
  createdByUserId String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  location        Location            @relation(fields: [locationId], references: [id], onDelete: Cascade)
  createdByUser   User?               @relation("LocationClosureCreatedByUser", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([locationId, startsAt, endsAt])
  @@index([createdByUserId])
}

model AppointmentCatalogVersion {
  id                 String                          @id @default(cuid())
  organizationId     String
  version            Int
  status             AppointmentCatalogVersionStatus @default(DRAFT)
  title              String
  description        String?
  reason             String
  catalogSnapshot    Json
  validationSnapshot Json
  createdByUserId    String?
  activatedByUserId  String?
  activatedAt        DateTime?
  retiredAt          DateTime?
  createdAt          DateTime                        @default(now())
  updatedAt          DateTime                        @updatedAt
  organization       Organization                    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdByUser      User?                           @relation("AppointmentCatalogVersionCreatedByUser", fields: [createdByUserId], references: [id], onDelete: SetNull)
  activatedByUser    User?                           @relation("AppointmentCatalogVersionActivatedByUser", fields: [activatedByUserId], references: [id], onDelete: SetNull)
  changeEvents       AppointmentCatalogChangeEvent[]
  automationRules    AppointmentAutomationRule[]

  @@unique([organizationId, version])
  @@index([organizationId, status])
  @@index([createdByUserId])
  @@index([activatedByUserId])
}

model AppointmentCatalogChangeEvent {
  id                 String                         @id @default(cuid())
  catalogVersionId   String
  organizationId     String
  actorUserId        String?
  action             AppointmentCatalogChangeAction
  reason             String
  priorSnapshot      Json?
  newSnapshot        Json
  validationSnapshot Json?
  occurredAt         DateTime                       @default(now())
  createdAt          DateTime                       @default(now())
  catalogVersion     AppointmentCatalogVersion      @relation(fields: [catalogVersionId], references: [id], onDelete: Cascade)
  organization       Organization                   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  actorUser          User?                          @relation("AppointmentCatalogChangeEventActorUser", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([catalogVersionId, occurredAt])
  @@index([organizationId, action, occurredAt])
  @@index([actorUserId, occurredAt])
}

model AppointmentAutomationRule {
  id                   String                                 @id @default(cuid())
  organizationId       String
  catalogVersionId     String?
  ruleCode             String
  name                 String
  description          String?
  triggerCode          String
  purposeCode          String
  status               AppointmentAutomationRuleStatus        @default(DRAFT)
