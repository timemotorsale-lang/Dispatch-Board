  vehicle                   Vehicle?                  @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  activityEvents            ActivityEvent[]
  checklistItems            TaskChecklistItem[]
  comments                  TaskComment[]
  appointmentLinks          AppointmentTaskLink[]
  appointmentHistoryEvents  AppointmentHistoryEvent[]
  concernLink               ConcernTaskLink?
  workRecommendations       WorkRecommendation[]
  assignmentRequests        TaskAssignmentRequest[]
  collaborators             TaskCollaborator[]
  customerLeadLink          CustomerLeadTaskLink?
  customer                  Customer?                 @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@unique([boardDayId, sourceTemplateId, assignedUserId])
  @@index([boardDayId, status])
  @@index([boardDayId, assignedUserId])
  @@index([boardDayId, workflowArea])
  @@index([acceptedByUserId, acceptedAt])
  @@index([completionOverrideByUserId, completionOverrideAt])
  @@index([vehicleId])
  @@index([boardDayId, isClaimable, status])
  @@unique([boardDayId, carryoverSourceTaskId])
  @@index([carryoverReportId])
  @@index([customerId, status, dueAt])
}

model TaskCollaborator {
  taskId        String
  userId        String
  addedByUserId String?
  createdAt     DateTime @default(now())
  task          Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user          User     @relation("TaskCollaboratorUser", fields: [userId], references: [id], onDelete: Cascade)
  addedByUser   User?    @relation("TaskCollaboratorAddedByUser", fields: [addedByUserId], references: [id], onDelete: SetNull)

  @@id([taskId, userId])
  @@index([userId, createdAt])
  @@index([addedByUserId])
}

model AppointmentTaskLink {
  id                 String                    @id @default(cuid())
  appointmentId      String
  taskId             String
  linkType           AppointmentTaskLinkType
  linkCode           String
  title              String
  explanation        String?
  isRequired         Boolean                   @default(false)
  blocksAppointment  Boolean                   @default(false)
  blocksTask         Boolean                   @default(false)
  automationRuleCode String?
  templateVersion    Int?
  createdByUserId    String?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  appointment        Appointment               @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  task               Task                      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  createdByUser      User?                     @relation("AppointmentTaskLinkCreatedByUser", fields: [createdByUserId], references: [id], onDelete: SetNull)
  historyEvents      AppointmentHistoryEvent[]

  @@unique([appointmentId, taskId, linkCode])
  @@index([appointmentId, linkType])
  @@index([taskId, linkType])
  @@index([automationRuleCode, templateVersion])
  @@index([createdByUserId])
}

model AppointmentHistoryEvent {
  id                    String                      @id @default(cuid())
  appointmentId         String
  actorType             AppointmentEventActorType
  actorUserId           String?
  taskId                String?
  appointmentTaskLinkId String?
  eventType             AppointmentHistoryEventType
  message               String
  reasonCode            String?
  reasonNotes           String?
  correlationId         String
  causationId           String?
  automationRuleCode    String?
  automationRuleVersion Int?
  priorValue            Json?
  newValue              Json?
  metadata              Json
  notificationIntent    Json?
  occurredAt            DateTime                    @default(now())
  createdAt             DateTime                    @default(now())
  appointment           Appointment                 @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  actorUser             User?                       @relation("AppointmentHistoryEventActorUser", fields: [actorUserId], references: [id], onDelete: SetNull)
  task                  Task?                       @relation(fields: [taskId], references: [id], onDelete: SetNull)
  appointmentTaskLink   AppointmentTaskLink?        @relation(fields: [appointmentTaskLinkId], references: [id], onDelete: SetNull)

  @@index([appointmentId, occurredAt])
  @@index([eventType, occurredAt])
  @@index([actorUserId, occurredAt])
  @@index([taskId, occurredAt])
  @@index([appointmentTaskLinkId])
  @@index([correlationId])
  @@index([automationRuleCode, automationRuleVersion])
}

model AppointmentCommandLedger {
  id                         String                   @id @default(cuid())
  organizationId             String
  locationId                 String?
  appointmentId              String?
  actorUserId                String?
  commandType                AppointmentCommandType
  status                     AppointmentCommandStatus @default(PENDING)
  idempotencyKey             String
  requestHash                String
  correlationId              String
  causationId                String?
  expectedAppointmentVersion Int?
  currentAppointmentVersion  Int?
  attemptCount               Int                      @default(0)
  maxAttempts                Int                      @default(0)
  nextRetryAt                DateTime?
  lockedAt                   DateTime?
  completedAt                DateTime?
  failedAt                   DateTime?
  resultSnapshot             Json?
  errorCode                  String?
  errorMessage               String?
  createdAt                  DateTime                 @default(now())
  updatedAt                  DateTime                 @updatedAt
  organization               Organization             @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  location                   Location?                @relation(fields: [locationId], references: [id], onDelete: SetNull)
  appointment                Appointment?             @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  actorUser                  User?                    @relation("AppointmentCommandLedgerActorUser", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@unique([organizationId, commandType, idempotencyKey])
  @@index([appointmentId, commandType, createdAt])
  @@index([locationId, status, createdAt])
  @@index([actorUserId, createdAt])
  @@index([correlationId])
  @@index([status, nextRetryAt])
}

model TaskChecklistItem {
  id                String                @id @default(cuid())
  taskId            String
  kind              TaskChecklistItemKind
  key               String?
  label             String
  isRequired        Boolean               @default(true)
  completed         Boolean               @default(false)
  sortOrder         Int
  completedAt       DateTime?
  completedByUserId String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  task              Task                  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  completedByUser   User?                 @relation("TaskChecklistCompletedByUser", fields: [completedByUserId], references: [id], onDelete: SetNull)

  @@unique([taskId, key])
  @@index([taskId, kind, sortOrder])
  @@index([taskId, completed])
}

model TaskComment {
  id           String   @id @default(cuid())
  taskId       String
  authorUserId String
  body         String
  createdAt    DateTime @default(now())
  task         Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorUser   User     @relation("TaskCommentAuthorUser", fields: [authorUserId], references: [id], onDelete: Restrict)

  @@index([taskId])
  @@index([taskId, createdAt])
}

model ActivityEvent {
  id            String       @id @default(cuid())
  boardDayId    String
  actorUserId   String?
  taskId        String?
  concernCaseId String?
  eventType     String
  message       String
  metadata      Json
  createdAt     DateTime     @default(now())
  boardDay      BoardDay     @relation(fields: [boardDayId], references: [id], onDelete: Cascade)
  actorUser     User?        @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  task          Task?        @relation(fields: [taskId], references: [id], onDelete: SetNull)
  concernCase   ConcernCase? @relation(fields: [concernCaseId], references: [id], onDelete: SetNull)

  @@index([boardDayId, createdAt])
  @@index([taskId])
  @@index([concernCaseId, createdAt])
}

model EnterpriseAggregateVersion {
  id             String       @id @default(cuid())
  organizationId String
  locationId     String?
  domain         String
  subjectType    String
  subjectId      String
  version        Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  location       Location?    @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, domain, subjectType, subjectId])
  @@index([locationId, domain, subjectType])
}

model EnterpriseCommandLedger {
  id              String                  @id @default(cuid())
  organizationId  String
  locationId      String?
  actorUserId     String
  domain          String
  subjectType     String
  subjectId       String
  commandType     String
  status          EnterpriseCommandStatus
  idempotencyKey  String
  requestHash     String
  correlationId   String
  expectedVersion Int
  resultingVersion Int?
  resultSnapshot  Json?
  errorCode       String?
  errorMessage    String?
  completedAt     DateTime?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  organization    Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  location        Location?               @relation(fields: [locationId], references: [id], onDelete: Restrict)
  actorUser       User                    @relation("EnterpriseCommandActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  domainEvents    EnterpriseDomainEvent[]
  auditEvents     EnterpriseAuditEvent[]

  @@unique([organizationId, domain, commandType, idempotencyKey])
  @@index([subjectType, subjectId, createdAt])
  @@index([locationId, status, createdAt])
  @@index([correlationId])
}

model EnterpriseDomainEvent {
  id               String                  @id @default(cuid())
  organizationId   String
  locationId       String?
  commandId        String
  domain            String
  aggregateType     String
  aggregateId       String
  aggregateVersion  Int
  eventType         String
  payload           Json
  occurredAt        DateTime                @default(now())
  createdAt         DateTime                @default(now())
  organization      Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  location          Location?               @relation(fields: [locationId], references: [id], onDelete: Restrict)
  command           EnterpriseCommandLedger @relation(fields: [commandId], references: [id], onDelete: Restrict)
  outboxMessages    EnterpriseOutboxMessage[]

  @@unique([organizationId, domain, aggregateType, aggregateId, aggregateVersion])
  @@index([commandId])
  @@index([eventType, occurredAt])
}

model EnterpriseAuditEvent {
  id              String                   @id @default(cuid())
  organizationId  String
  locationId      String?
  actorUserId     String
  commandId       String?
  domain          String
  subjectType     String
  subjectId       String
  eventType       String
  reason          String
  priorValue      Json?
  newValue        Json?
  metadata        Json
  correlationId   String
  occurredAt      DateTime                 @default(now())
  createdAt       DateTime                 @default(now())
  organization    Organization             @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  location        Location?                @relation(fields: [locationId], references: [id], onDelete: Restrict)
  actorUser       User                     @relation("EnterpriseAuditActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  command         EnterpriseCommandLedger? @relation(fields: [commandId], references: [id], onDelete: SetNull)

  @@index([subjectType, subjectId, occurredAt])
  @@index([actorUserId, occurredAt])
  @@index([correlationId])
}

model EnterpriseOutboxMessage {
  id              String                 @id @default(cuid())
  organizationId  String
  locationId      String?
  domainEventId   String
  topic           String
  messageKey      String
  payload         Json
  status          EnterpriseOutboxStatus @default(PENDING)
  attemptCount    Int                    @default(0)
  maxAttempts     Int                    @default(5)
  nextAttemptAt   DateTime               @default(now())
  lockedAt        DateTime?
  publishedAt     DateTime?
  lastError       String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  organization    Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  location        Location?              @relation(fields: [locationId], references: [id], onDelete: Restrict)
  domainEvent     EnterpriseDomainEvent  @relation(fields: [domainEventId], references: [id], onDelete: Restrict)

  @@unique([domainEventId, topic])
  @@index([status, nextAttemptAt])
  @@index([organizationId, locationId, createdAt])
}

model VehicleCapabilityGrant {
  id             String           @id @default(cuid())
  organizationId String
  locationId     String?
  userId         String
  capability     String
  effect         CapabilityEffect @default(ALLOW)
  constraints    Json
  validFrom      DateTime         @default(now())
  validTo        DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  location       Location?        @relation(fields: [locationId], references: [id], onDelete: Restrict)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, locationId, userId, capability])
  @@index([userId, capability, validFrom, validTo])
}

model VehicleOperationsFeatureFlag {
