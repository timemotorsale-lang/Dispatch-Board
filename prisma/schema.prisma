  purpose              String
  nextAction           String
  definitionOfDone     String
  urgency              InventoryWorkUrgency         @default(P3)
  urgencyReason        String
  readiness            InventoryWorkReadiness       @default(UNKNOWN)
  readinessSnapshot    Json
  dependencySnapshot   Json
  evidenceRequirements Json
  blockerRecovery      Json?
  handoff              Json?
  targetAt             DateTime
  nextCheckAt          DateTime?
  escalationAt         DateTime?
  estimatedMinutes     Int?
  policyVersion        String
  version              Int                          @default(1)
  createdByUserId      String
