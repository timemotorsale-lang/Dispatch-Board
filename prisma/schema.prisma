  location        Location?                    @relation(fields: [locationId], references: [id], onDelete: Restrict)
  updatedByUser   User?                        @relation("VehicleOperationsFeatureFlagUpdater", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@unique([organizationId, locationId, code])
