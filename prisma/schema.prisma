  pilotId             String
  gateCode            String
  status              InventoryConsoleEvidenceStatus @default(NOT_STARTED)
  summary             String
  evidenceReferences  Json
  measurementSnapshot Json
  submittedByUserId   String?
  submittedAt         DateTime?
  reviewedByUserId    String?
  reviewedAt          DateTime?
  expiresAt           DateTime?
  waiverAuthority     String?
  waiverReason        String?
  version             Int                            @default(1)
  createdAt           DateTime                       @default(now())
  updatedAt           DateTime                       @updatedAt
  organization        Organization                   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  pilot               InventoryConsolePilot          @relation(fields: [pilotId], references: [id], onDelete: Cascade)

  @@unique([pilotId, gateCode])
  @@index([organizationId, gateCode, status])
}

model InventoryConsoleSignoff {
  id             String                          @id @default(cuid())
  organizationId String
  pilotId        String
  dimension      String
  decision       InventoryConsoleSignoffDecision @default(PENDING)
  signerUserId   String?
  reason         String?
  evidenceRefs   Json
  decidedAt      DateTime?
  version        Int                             @default(1)
  createdAt      DateTime                        @default(now())
  updatedAt      DateTime                        @updatedAt
  organization   Organization                    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  pilot          InventoryConsolePilot           @relation(fields: [pilotId], references: [id], onDelete: Cascade)

  @@unique([pilotId, dimension])
  @@index([organizationId, decision, updatedAt])
}

model GenerationRun {
  id                String                @id @default(cuid())
  boardDate         DateTime              @db.Date
  startedAt         DateTime              @default(now())
  finishedAt        DateTime?
  status            GenerationRunStatus   @default(RUNNING)
  triggeredBy       GenerationTriggerType
  triggeredByUserId String?
  summary           Json
  errorMessage      String?
  triggeredByUser   User?                 @relation("GenerationRunTriggeredByUser", fields: [triggeredByUserId], references: [id], onDelete: SetNull)

  @@index([boardDate, startedAt])
}

model SchedulerAttempt {
  id                     String                        @id @default(cuid())
  boardDate              DateTime                      @db.Date
  triggerType            GenerationTriggerType         @default(SCHEDULED)
  triggerSource          SchedulerTriggerSource        @default(UNKNOWN)
  routePath              String
  requestMethod          String
  receivedAt             DateTime                      @default(now())
  startedAt              DateTime?
  completedAt            DateTime?
  attemptState           SchedulerAttemptState         @default(RECEIVED)
  authorizationOutcome   SchedulerAuthorizationOutcome @default(PENDING)
  generationRunId        String?
  managerMessage         String
  skipReasonCode         SchedulerSkipReasonCode?
  unauthorizedReasonCode String?
  failureStage           SchedulerFailureStage?
  failureCode            String?
  failureDiagnostic      Json?
  safeErrorMessage       String?
  createdAt              DateTime                      @default(now())
  updatedAt              DateTime                      @updatedAt

  @@index([boardDate, receivedAt])
  @@index([attemptState, receivedAt])
  @@index([authorizationOutcome, receivedAt])
  @@index([generationRunId])
}
