model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Role {
  id                String             @id @default(cuid())
  name              String             @unique
  description       String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  userRoles         UserRole[]
  roleDuties        RoleDuty[]
  templates         TaskTemplate[]
  staffDayDutyItems StaffDayDutyItem[]
}

model Duty {
  id                String             @id @default(cuid())
  name              String             @unique
  workflowArea      String
  description       String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  userDuties        UserDuty[]
  roleDuties        RoleDuty[]
  templates         TaskTemplate[]
  sourceTasks       Task[]             @relation("TaskSourceDuty")
  staffDayDutyItems StaffDayDutyItem[]
}

model UserRole {
  userId     String
  roleId     String
  assignedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

model UserDuty {
  userId     String
  dutyId     String
  assignedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  duty       Duty     @relation(fields: [dutyId], references: [id], onDelete: Cascade)

  @@id([userId, dutyId])
  @@index([dutyId])
}

model RoleDuty {
  roleId     String
  dutyId     String
  assignedAt DateTime @default(now())
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  duty       Duty     @relation(fields: [dutyId], references: [id], onDelete: Cascade)

  @@id([roleId, dutyId])
  @@index([dutyId])
}

model AppSetting {
  id                  String        @id
  dailyGenerationTime String
  timezone            String
  businessDays        BusinessDay[]
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
}

