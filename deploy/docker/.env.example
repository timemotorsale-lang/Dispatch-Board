# Used only by the base Caddy deployment. The Tailscale override disables Caddy,
# so its default value can remain unchanged for a Tailscale-only deployment.
APP_DOMAIN=dispatch.example.com
APP_TIMEZONE=America/Chicago

# Use URL-safe values. `openssl rand -hex 32` is a convenient generator.
POSTGRES_DB=dispatch_board
POSTGRES_USER=dispatch_app
POSTGRES_PASSWORD=replace-with-a-long-random-hex-value
CRON_SECRET=replace-with-a-different-long-random-hex-value

# Scheduler and backup defaults.
CRON_INTERVAL_MS=900000
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=14

# Optional image/version labels for controlled upgrades and rollbacks.
APP_VERSION=local

# Customer Console / CRM Next. Docker maps this deployment control to the
# app's CRM_NEXT runtime variable. Use REVIEW to open the safe operating preview;
# use DOGFOOD/PILOT/LIVE/ACTIVE only when dogfood task handoffs are approved.
CRM_NEXT_DOCKER_MODE=REVIEW

# Stable tenant key used in private document object paths.
DOCUMENT_LIBRARY_ORGANIZATION_ID=org-time-motor-sales

# Set to true for exactly one Portainer redeploy when you want to seed data.
SEED_ON_DEPLOY=false

# Demo/pilot records stay off unless both switches are deliberately enabled.
ENABLE_DEMO_DATA=false
ENABLE_SHOP_RECON_PILOT_SEED=false

# Private Tailscale Serve exposure for Dispatch Board.
DISPATCH_BOARD_TAILSCALE_SERVE_CHECK=true
DISPATCH_BOARD_TAILSCALE_SERVE_AUTOCONFIGURE=true
TAILSCALE_SERVE_TARGET=http://127.0.0.1:3000
TAILSCALE_SERVE_HTTPS_PORT=443
