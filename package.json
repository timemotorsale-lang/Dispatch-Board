{
  "name": "dispatch-board",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prebuild": "node scripts/prepare-prisma-client.mjs",
    "predev": "node scripts/clean-dev-runtime-cache.mjs && node scripts/prepare-dev-runtime.mjs",
    "dev": "node scripts/run-dev.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:inventory-import-ui": "node scripts/check-purchase-import-ui.mjs",
    "check:purchase-import-release": "tsx scripts/check-purchase-import-release.ts",
    "reports:worker": "tsx scripts/run-reporting-worker.ts",
    "test:e2e": "node scripts/run-e2e.mjs",
    "test:e2e:ui": "playwright test --ui",
    "validate:inventory-console": "tsx scripts/validate-inventory-console-program.ts",
    "check:inventory-access": "tsx scripts/check-inventory-console-access.ts",
    "audit:inventory-console-slices": "tsx scripts/audit-inventory-console-vertical-slices.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:reset": "prisma migrate reset",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:shop-recon-pilot": "tsx scripts/seed-shop-recon-pilot.ts",
    "db:cleanup-pilot-data": "tsx scripts/cleanup-pilot-data.ts",
    "db:consolidate-open-repair-orders": "tsx scripts/consolidate-open-repair-order-duplicates.ts",
    "db:backfill-repair-order-tasks": "tsx scripts/backfill-repair-order-tasks.ts",
    "diagnostics:trial": "tsx scripts/configure-diagnostics-trial.ts",
    "db:validate": "prisma validate"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@tesseract.js-data/eng": "^1.0.0",
    "@zxing/browser": "^0.2.1",
    "exceljs": "^4.4.0",
    "fflate": "^0.8.3",
    "lucide-react": "^1.21.0",
    "next": "^16.2.9",
    "papaparse": "^5.7.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tesseract.js": "^7.0.0"
  },
  "overrides": { "exceljs": { "uuid": "^11.1.1" } },
  "devDependencies": {
    "@playwright/test": "^1.51.1",
    "@types/node": "^25.9.3",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.9",
    "prisma": "^6.19.3",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
