DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dispatch_board?schema=public"
CRON_SECRET="replace-with-a-long-random-secret"
NEXT_DIST_DIR=".next-local"

# Staff login email delivery. Local/dev defaults to console delivery.
# Production should use AUTH_EMAIL_PROVIDER="resend" with RESEND_API_KEY and AUTH_EMAIL_FROM.
AUTH_PUBLIC_BASE_URL="http://localhost:3001"
AUTH_EMAIL_PROVIDER="console"
AUTH_EMAIL_FROM="Time Motor Sales <no-reply@example.com>"
AUTH_EMAIL_REPLY_TO="manager@example.com"
RESEND_API_KEY=""

# Customer Console / CRM Next. Keep OFF unless the deployment should open /crm-next.
# Use REVIEW for the current safe operating preview; DOGFOOD/PILOT/LIVE/ACTIVE unlock the dogfood mode.
CRM_NEXT="OFF"

# UCRM-010/011 review shell. Production stays off unless explicitly set to REVIEW.
UNIFIED_CRM_SHELL_MODE="OFF"

# UCRM-012/013 canonical customer reads. Controlled independently from the shell;
# production stays off unless both switches are explicitly set to REVIEW.
UNIFIED_CRM_CUSTOMER_READ_MODE="OFF"

# DB-ACCOUNTABILITY-059 rollout flags. Keep the master flag off until the pilot gate.
STAFF_EXECUTION_ENABLED="false"
STAFF_EXECUTION_START_DAY_ENABLED="false"
STAFF_EXECUTION_TASK_ACCEPTANCE_ENABLED="false"
STAFF_EXECUTION_AVAILABLE_WORK_ENABLED="false"
STAFF_EXECUTION_END_OF_DAY_ENABLED="false"
STAFF_EXECUTION_MANAGER_HEALTH_ENABLED="false"

# Demo/pilot records stay off unless both switches are deliberately enabled.
ENABLE_DEMO_DATA="false"
ENABLE_SHOP_RECON_PILOT_SEED="false"

# Staff Website Console links. These do not deploy or publish the public app.
# Published website: HTTPS origin only; leave empty until a domain is approved.
DEALERSHIP_PUBLIC_URL=""
# Development defaults to http://127.0.0.1:3100. Loopback HTTP only.
# Automatically hidden once DEALERSHIP_PUBLIC_URL is valid; never shown in production.
DEALERSHIP_PREVIEW_URL=""
# Set false to hide the preview before the public address is established.
DEALERSHIP_PREVIEW_ENABLED="true"
